	(text "VCCA = +3V3 (poziomy FPGA), VCCB = VBUS (5 V) -> wyjscia 5 V CMOS. OE na stale = 1 (+3V3)."
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
