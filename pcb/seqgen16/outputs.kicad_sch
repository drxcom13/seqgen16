		)
		(uuid "e32d9bfb-73f7-4f05-bf0e-d328aec16b16")
	)
	(text "Wejscia i OE TXU maja wewnetrzne pull-down 5M -> podczas konfiguracji FPGA wyjscia ida w stan zgodny z pinami FPGA."
