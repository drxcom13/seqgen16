	(text "Output buffers: TXU0104 (CH0..CH15), TXU0102 (BASE_CLK, SYNC). Fixed direction A->B."
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "0fa389ff-5bf1-4b6d-90cb-44d6393628d6")
	)
	(text "Nets OUT_CH0..15 -> J3 (2x16), OUT_CLK -> J4 (2x2), OUT_SYNC -> J5 (2x2); every second pin = GND."
		(exclude_from_sim no)
		(at 25.4 39.37 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "544275d5-dd70-408a-aa65-c5c1c85b8a9f")
	)
	(text "VCCA = +3V3 (FPGA levels), VCCB = VCCB_A (U4, U5) / VCCB_B (U6..U8) from LDOs U11/U12 on the Power sheet: 1.8 / 2.5 / 3.3 / 4.0 / ~5 V set by the FPGA, 0 V (Hi-Z) when off. OE tied high (+3V3)."
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8bfe2200-2da5-4248-bb03-ad0238882c7b")
	)
	(text "J3: odd pins = OUT_CH0..15, even pins = GND. J4/J5: 1,3 = signal, 2,4 = GND (right-angle headers, 2.54 mm)."
		(exclude_from_sim no)
		(at 25.4 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "abfacec4-7f23-4a87-8593-23d65fce1d0f")
	)
	(text "Each output: 33R series + TVS TSD05C (bidirectional, VRWM 5.5 V, SOD-323) to GND at the connector."
		(exclude_from_sim no)
		(at 25.4 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e32d9bfb-73f7-4f05-bf0e-d328aec16b16")
	)
	(text "TXU inputs and OE have internal 5M pull-downs -> during FPGA configuration the outputs follow the FPGA pins."
		(exclude_from_sim no)
		(at 25.4 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f2aa8a4f-810a-4511-8d32-e0c25f7aeb34")
	)
