	(text "U10 TPS22917 load switch: whole board VBUS (C15 47u, C16, VCCB LDO inputs, ~54 uF) soft-started, CT C45 2.2n -> ~5 ms ramp, inrush ~55 mA. At plug-in USB sees only C1/C2 (~4.8 uF < 10 uF, USB 2.0)."
		(exclude_from_sim no)
		(at 25.4 41.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "308be35b-888d-46ed-87a5-cd8046430e8a")
	)
	(text "USB-C as device: CC1/CC2 via 5.1k to GND. ESD USBLC6-2SC6 close to the connector."
		(exclude_from_sim no)
		(at 25.4 34.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8cc50d1b-be9d-4072-8aca-2fd32d35fd30")
	)
	(text "CBUS0/CBUS1 default TXLED#/RXLED# (FT232 EEPROM). RESET#, OSCI/OSCO unused - internal oscillator."
		(exclude_from_sim no)
		(at 25.4 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "945c0ff8-f00e-4581-b475-f12de0ede4f7")
	)
	(text "TXD/RXD - named from the FPGA side: RXD = FT232 TXD output -> FPGA pin 69, TXD = FPGA pin 70 -> FT232 RXD input."
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c54b347c-8214-4836-a31f-fa0aa3054ac9")
	)
	(text "USB-UART: FT232RNL (FT232RL symbol, same SSOP-28 pinout). VCCIO = 3.3 V -> FPGA-compatible levels."
		(exclude_from_sim no)
		(at 25.4 25.4 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "d5402447-98c7-403c-b3eb-f2209ea2b39f")
	)
