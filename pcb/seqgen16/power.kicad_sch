	(text "U1 = 10M08SAE144, ADC not used: ANAIN1 and REFGND to GND, ADC_VREF NC (MAX 10 guidelines). No MCP1525."
		(exclude_from_sim no)
		(at 25.4 39.37 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "12f9778a-7144-4404-8805-e39b99cae7bd")
	)
	(text "TPSM828302 (SLVSGM1D): CIN >= 4.7u X7R at VIN (C16), COUT >= 12u effective (C18 47u). R36 200k..600k (1%). MODE = GND (auto PSM/PWM). EN from VBUS via R23/C17. PG, SW not connected."
		(exclude_from_sim no)
		(at 25.4 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1e927eae-8d6c-409e-bfed-f1fde38388ef")
	)
	(text "Footprint TPSM828302ARDSR (QFN-FCMOD-9 3x3 mm, RDS0009A) - to be drawn from the TI land pattern (large pads 6 VOUT and 8 SW), SW small pad only."
		(exclude_from_sim no)
		(at 25.4 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3acc0872-f54e-48cb-9bde-9bc7ad71665d")
	)
	(text "VCCIO1A..8 = +3V3 directly; VCCA1..6 = +3V3 via ferrite FB2; VCC_ONE = +3V3 via ferrite FB3 (SA device: single 3.3 V supply)."
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "63ba7d39-fadc-47c5-a933-0f2e88ef2ba7")
	)
	(text "VCCA / VCC_ONE / VCCIO - place the capacitors close to the FPGA pins."
		(exclude_from_sim no)
		(at 25.4 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "65acc24a-ce6e-4cf3-b1d4-e3f9fa4fd06d")
	)
	(text "Power: VBUS 5 V -> TI TPSM828302 (2 A buck module with inductor, 2 MHz) -> +3V3. VOUT = 0.5 V x (1 + R35/R36) = 3.30 V."
