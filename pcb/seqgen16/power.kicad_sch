		(uuid "3acc0872-f54e-48cb-9bde-9bc7ad71665d")
	)
	(text "VCCIO1A..8 = +3V3 directly; VCCA1..6 = +3V3 via ferrite FB2; VCC_ONE = +3V3 via ferrite FB3 (SA device: single 3.3 V supply)."
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "63ba7d39-fadc-47c5-a933-0f2e88ef2ba7")
	)
	(text "VCCA / VCC_ONE / VCCIO - place the capacitors close to the FPGA pins."
		(exclude_from_sim no)
		(at 44.704 95.758 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "65acc24a-ce6e-4cf3-b1d4-e3f9fa4fd06d")
	)
	(text "VCCB (TXU output level): U11 -> VCCB_A (U4, U5), U12 -> VCCB_B (U6..U8), TLV75801P, VOUT = 0.55 V x (1 + Rtop/Rbot). VCCB_OFF high or FPGA unconfigured -> LDOs off, outputs Hi-Z."
		(exclude_from_sim no)
		(at 25.4 42.545 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6d00525f-1007-42eb-9433-e11a6b7c5c07")
	)
	(text "Power: VBUS 5 V -> TI TPSM828302 (2 A buck module with inductor, 2 MHz) -> +3V3. VOUT = 0.5 V x (1 + R35/R36) = 3.30 V."
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "a935de94-d92e-43bd-ae71-222888832fa7")
	)
	(text "FPGA open-drain pins (low = active): none 1.8 V, VSEL_2V5_N 2.5 V, VSEL_3V3_N 3.3 V, 2V5 + 3V3 4.0 V, VSEL_5V_N dropout ~VBUS (5 V)."
		(exclude_from_sim no)
		(at 25.4 46.355 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "abe0c6fd-3e75-4fee-87b3-6404f24cd197")
	)
