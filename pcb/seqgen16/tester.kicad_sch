	(text "Protocol tester: J6 = SPI / I2C / UART TTL, logic level PVCC from U13 (TLV75801P, same divider as VCCB): off, 1.8 / 2.5 / 3.3 / 4.0 / ~5 V."
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6778e06d-4262-4662-9fb8-6fdef8c0d6d4")
	)
	(text "SN74LVC1T45: A = FPGA (+3V3), B = J6 (PVCC), DIR high = A->B; outputs Hi-Z while PVCC is off. I2C: 2N7002 open drain + LVC2T45 input (any PVCC). JP3 = 2.2k pull-ups to PVCC."
		(exclude_from_sim no)
		(at 25.4 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "25080f8e-9234-4a4a-862a-713b2f0e7ba6")
	)
	(text "PVCC_OFF high or FPGA unconfigured -> U13 off. J6 pin 1 = PVCC output (do not tie to a powered target supply)."
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "184b4970-d5ff-444a-bf5c-8392526ce157")
	)
