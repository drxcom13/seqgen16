set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M08SAE144C8G
set_global_assignment -name TOP_LEVEL_ENTITY seqgen16_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 SP0.02std Lite Edition"

set_global_assignment -name VHDL_FILE seqgen16_top.vhd
set_global_assignment -name QIP_FILE nios_sys/synthesis/nios_sys.qip
set_global_assignment -name SDC_FILE seqgen16.sdc

# On-chip RAM Nios inicjalizowany z pliku -> wymagany tryb z inicjalizacja pamieci
set_global_assignment -name INTERNAL_FLASH_UPDATE_MODE "SINGLE IMAGE WITH ERAM"
set_global_assignment -name ON_CHIP_BITSTREAM_DECOMPRESSION OFF
set_global_assignment -name ENABLE_OCT_DONE OFF
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVCMOS"

# =============================================================================
# PINY - wlasna plytka pcb/seqgen16 (KiCad, etykiety globalne na U1 w fpga.kicad_sch)
# Przy zmianie pinow aktualizuj oba miejsca: ten plik i schemat.
# Poprzednie przypisanie dla MAX 10 10M08 Evaluation Kit: historia git (commit 22c6dcf).
# =============================================================================
set_location_assignment PIN_27  -to clk_50

# LED (aktywne zerem) - jak na plytce ewaluacyjnej, na wlasnej plytce jeszcze nie zaprojektowane
set_location_assignment PIN_132 -to led_n[0]
set_location_assignment PIN_134 -to led_n[1]
set_location_assignment PIN_135 -to led_n[2]
set_location_assignment PIN_140 -to led_n[3]
set_location_assignment PIN_141 -to led_n[4]

# UART (nazwy od strony FPGA): TXD -> RX mostka USB, RXD <- TX mostka USB (bank 4)
set_location_assignment PIN_70  -to uart_txd
set_location_assignment PIN_69  -to uart_rxd

# Kanaly 0..15 (bank 3)
set_location_assignment PIN_41  -to ch_out[0]
set_location_assignment PIN_38  -to ch_out[1]
set_location_assignment PIN_43  -to ch_out[2]
set_location_assignment PIN_39  -to ch_out[3]
set_location_assignment PIN_46  -to ch_out[4]
set_location_assignment PIN_44  -to ch_out[5]
set_location_assignment PIN_47  -to ch_out[6]
set_location_assignment PIN_45  -to ch_out[7]
set_location_assignment PIN_55  -to ch_out[8]
set_location_assignment PIN_50  -to ch_out[9]
set_location_assignment PIN_56  -to ch_out[10]
set_location_assignment PIN_52  -to ch_out[11]
set_location_assignment PIN_59  -to ch_out[12]
set_location_assignment PIN_57  -to ch_out[13]
set_location_assignment PIN_60  -to ch_out[14]
set_location_assignment PIN_58  -to ch_out[15]

# SYNC i zegar bazowy na dwufunkcyjnych pinach zegarowych CLK1n/CLK1p (bank 2), uzyte jako wyjscia
set_location_assignment PIN_28  -to sync_out
set_location_assignment PIN_29  -to clk_base
set_instance_assignment -name SLEW_RATE 2 -to clk_base
set_instance_assignment -name SLEW_RATE 2 -to sync_out

# Ostatni rejestr kazdego wyjscia w komorce I/O -> minimalny rozrzut opoznien miedzy pinami
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to ch_out[*]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to clk_base
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to sync_out

set_instance_assignment -name SLEW_RATE 2 -to ch_out[*]
