set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M08SAE144C8G
set_global_assignment -name TOP_LEVEL_ENTITY seqgen16_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 SP0.02std Lite Edition"

set_global_assignment -name VHDL_FILE reset_ctrl.vhd
set_global_assignment -name VHDL_FILE seqgen16_top.vhd
set_global_assignment -name QIP_FILE nios_sys/synthesis/nios_sys.qip
set_global_assignment -name SDC_FILE seqgen16.sdc

# On-chip RAM Nios inicjalizowany z pliku -> wymagany tryb z inicjalizacja pamieci
set_global_assignment -name INTERNAL_FLASH_UPDATE_MODE "SINGLE IMAGE WITH ERAM"
set_global_assignment -name ON_CHIP_BITSTREAM_DECOMPRESSION OFF
set_global_assignment -name ENABLE_OCT_DONE OFF
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVCMOS"

# =============================================================================
# PINY - wlasna plytka pcb/seqgen16 (KiCad, etykiety globalne na U1 w fpga.kicad_sch)
# Przy zmianie pinow aktualizuj oba miejsca: ten plik i schemat.
# Poprzednie przypisanie dla MAX 10 10M08 Evaluation Kit: historia git (commit 22c6dcf).
# =============================================================================
set_location_assignment PIN_27  -to clk_50

# Przycisk RESET (SW1 na arkuszu Config, pull-up R29 1k), aktywny stanem niskim.
# Pin 121 = DEV_CLRn uzyty jako zwykle wejscie: device-wide reset musi byc wylaczony.
# Wewnetrzny pull-up - na plytce ewaluacyjnej pin moze byc niepodlaczony.
set_location_assignment PIN_121 -to reset_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to reset_n
set_global_assignment -name ENABLE_DEVICE_WIDE_RESET OFF

# LED (aktywne zerem). Na wlasnej plytce: LED1 = led_n[0] (pin 132, siec LED1_N), LED2 = led_n[1]
# (pin 134, LED2_N) - arkusz Config. led_n[2..4] (135/140/141) na plytce niepodlaczone, w FPGA na stale = 1 (wylaczone).
set_location_assignment PIN_132 -to led_n[0]
set_location_assignment PIN_134 -to led_n[1]
set_location_assignment PIN_135 -to led_n[2]
set_location_assignment PIN_140 -to led_n[3]
set_location_assignment PIN_141 -to led_n[4]

# UART (nazwy od strony FPGA): TXD -> RX mostka USB, RXD <- TX mostka USB (bank 7)
set_location_assignment PIN_111 -to uart_txd
set_location_assignment PIN_110 -to uart_rxd

# Kanaly 0..15 (bank 3), kolejnosc pinow malejaca = CH0 u gory J3 na plytce seqgen16
set_location_assignment PIN_60  -to ch_out[0]
set_location_assignment PIN_59  -to ch_out[1]
set_location_assignment PIN_58  -to ch_out[2]
set_location_assignment PIN_57  -to ch_out[3]
set_location_assignment PIN_56  -to ch_out[4]
set_location_assignment PIN_55  -to ch_out[5]
set_location_assignment PIN_54  -to ch_out[6]
set_location_assignment PIN_50  -to ch_out[7]
set_location_assignment PIN_47  -to ch_out[8]
set_location_assignment PIN_46  -to ch_out[9]
set_location_assignment PIN_45  -to ch_out[10]
set_location_assignment PIN_44  -to ch_out[11]
set_location_assignment PIN_43  -to ch_out[12]
set_location_assignment PIN_41  -to ch_out[13]
set_location_assignment PIN_39  -to ch_out[14]
set_location_assignment PIN_38  -to ch_out[15]

# Poziom wyjsc VCCB (arkusz Power: LDO U11/U12, Q1). vccb_off = 1 wylacza LDO.
# vsel_*_n open-drain do dzielnika FB LDO - bez pull-upow (prad pull-upu zmienilby napiecie).
set_location_assignment PIN_61  -to vccb_off
set_location_assignment PIN_62  -to vsel_2v5_n
set_location_assignment PIN_64  -to vsel_3v3_n
set_location_assignment PIN_65  -to vsel_5v_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to vsel_2v5_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to vsel_3v3_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to vsel_5v_n

# Tester protokolow (zlacze J6, arkusz Protocol tester): banki 5 i 6
set_location_assignment PIN_80  -to pt_sck
set_location_assignment PIN_81  -to pt_mosi
set_location_assignment PIN_84  -to pt_cs
set_location_assignment PIN_85  -to pt_miso
set_location_assignment PIN_86  -to pt_dir_spi
set_location_assignment PIN_87  -to pt_dir_miso
set_location_assignment PIN_77  -to pt_tx
set_location_assignment PIN_79  -to pt_dir_tx
set_location_assignment PIN_98  -to pt_rx
set_location_assignment PIN_88  -to pt_sda_in
set_location_assignment PIN_89  -to pt_scl_in
set_location_assignment PIN_90  -to pt_sda_drv
set_location_assignment PIN_91  -to pt_scl_drv
# PVCC (LDO U13, Q2): jak VCCB - psel_*_n open-drain bez pull-upow
set_location_assignment PIN_92  -to pvcc_off
set_location_assignment PIN_93  -to psel_2v5_n
set_location_assignment PIN_96  -to psel_3v3_n
set_location_assignment PIN_97  -to psel_5v_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to psel_2v5_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to psel_3v3_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to psel_5v_n

# SYNC i zegar bazowy na dwufunkcyjnych pinach zegarowych CLK1n/CLK1p (bank 2), uzyte jako wyjscia
set_location_assignment PIN_28  -to sync_out
set_location_assignment PIN_29  -to clk_base
set_instance_assignment -name SLEW_RATE 2 -to clk_base
set_instance_assignment -name SLEW_RATE 2 -to sync_out

# Ostatni rejestr kazdego wyjscia w komorce I/O -> minimalny rozrzut opoznien miedzy pinami
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to ch_out[*]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to clk_base
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to sync_out

set_instance_assignment -name SLEW_RATE 2 -to ch_out[*]
